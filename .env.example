# Copy to .env to customize. scripts/demo.sh falls back to these exact values,
# so the demo runs with zero setup — .env is optional.
#
#   cp .env.example .env

# Port the app listens on. The mock CMS base URL derives from it, so every
# process needs its own PORT. Every scripts/demo.sh command honors an override:
#   PORT=3001 ./scripts/demo.sh peek
PORT=3000

# The article scripts/demo.sh drives by default. `./scripts/demo.sh articles`
# lists all four seeded paths.
DEMO_ARTICLE=investing/2026/07/22/should-you-buy-spacex-stock-before-aug-4

# Shared secret for POST /api/internal/revalidate (header: x-revalidate-secret).
# Unset means deny-by-default — every push call 401s. That is not "auth off".
REVALIDATE_SECRET=demo-secret

# Set   => the mock CMS fires a webhook on publish, so push invalidation is on.
# Unset => push is off and the background refresher carries corrections instead
#          (MANUAL_TESTING.md Test 9 — push is an optimization, not a
#          dependency). scripts/demo.sh derives this from PORT when unset;
#          `./scripts/demo.sh serve --no-webhook` forces it off.
#CMS_WEBHOOK_URL=http://localhost:3000/api/internal/revalidate

# Where the app fetches article content from. Defaults to
# http://localhost:$PORT/api/cms, which is the in-repo mock CMS.
#CMS_BASE_URL=

# How often the background refresher re-probes every warm article, in ms.
# Defaults to 2000; a bad value falls back to that rather than failing to boot.
# Raise it to make the circuit breaker easy to catch `open` by hand — each tick
# succeeds against the real CMS and resets the consecutive-failure count, so at
# 2s three-in-a-row is hard to land (MANUAL_TESTING.md Test 4). Lowering it
# tightens correction lag when push is off, at the cost of more upstream calls.
REFRESH_INTERVAL_MS=20000

# Where `./scripts/demo.sh serve` tees the server's structured logs, and where
# `./scripts/demo.sh logs|tail` reads them back from.
DEMO_LOG=/tmp/demo.log
